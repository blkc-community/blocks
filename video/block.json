{
  "$schema": "https://blkc.blackcode.space/schemas/v2/block.json",
  "manifestVersion": 2,
  "kind": "ui",
  "id": "video",
  "name": "Video",
  "summary": "A YouTube or Vimeo video, or a video file.",
  "description": "Embeds a YouTube or Vimeo video, or a video file. Heading and caption are optional. The web renderer lives in @blkc-code/render-web.",
  "version": "1.0.0",
  "category": "media",
  "tags": ["ui", "section", "video"],
  "license": "MIT",
  "authors": [
    {"name": "BLKC Core Team", "role": "Platform"}
  ],
  "repository": "https://github.com/blkc-community/blocks/tree/main/video",
  "attributes": {
    "heading": {"type": "string", "maxLength": 120, "label": "Heading"},
    "text": {"type": "string", "maxLength": 280, "label": "Text above the video"},
    "url": {"type": "string", "format": "uri", "maxLength": 2000, "label": "Video link"},
    "caption": {"type": "string", "maxLength": 200, "label": "Caption"}
  },
  "renderers": {
    "web": {"package": "@blkc-code/render-web", "export": "VideoBlock", "version": "^0.2.0"}
  },
  "example": {
    "heading": "Watch",
    "text": "A short film about BLKC.",
    "url": "https://www.youtube.com/watch?v=example",
    "caption": "BLKC v2"
  },
  "visibility": "public",
  "changelog": []
}
