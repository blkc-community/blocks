                        "description":  "Embedding length"
                    }
                ],
    "visibility":  "public",
    "changelog":  [

                  ],
    "sizeMB":  0.01,
    "repository":  "https://github.com/blkc-community/blocks/tree/main/embedder-bge-small"
}
