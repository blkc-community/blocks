    "version":  "0.1.0",
    "tags":  [
                 "embeddings",
                 "vector"
             ],
    "entryPoint":  "./src/index.ts",
    "runtime":  "bun",
    "license":  "MIT",
    "authors":  [
                    {
                        "name":  "BLKC Core Team",
                        "role":  "Platform"
                    }
                ],
    "inputs":  [
                   "text"
               ],
    "outputs":  [
                    "embedding"
                ],
    "capabilities":  [
                         {
